{
  "name": "@dynamicsninja/garminconnect-mcp",
  "version": "0.8.1",
  "description": "MCP server for Garmin Connect: create workouts and read your Garmin data from Claude. Built on garminconnect-js.",
  "keywords": [
    "garmin",
    "garmin-connect",
    "mcp",
    "model-context-protocol",
    "claude",
    "workouts"
  ],
  "homepage": "https://github.com/DynamicsNinja/garminconnect-js/tree/main/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DynamicsNinja/garminconnect-js.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/DynamicsNinja/garminconnect-js/issues"
  },
  "author": "ificko",
  "license": "MIT",
  "type": "module",
  "bin": {
    "garminconnect-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "build:mcpb": "tsx scripts/build-mcpb.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm run build:mcpb && npm test",
    "prepublishOnly": "npm run check",
    "prepack": "node -e \"for (const f of ['LICENSE','NOTICE']) require('fs').copyFileSync('../'+f, f)\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ajv": "^8.20.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@resvg/resvg-js": "^2.6.2"
  }
}
