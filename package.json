{
  "name": "garminconnect-js",
  "version": "0.5.0",
  "description": "TypeScript client for the Garmin Connect API, for Node and Next.js server runtimes",
  "keywords": [
    "garmin",
    "garmin-connect",
    "garminconnect",
    "fitness",
    "health",
    "activities",
    "workouts",
    "nextjs",
    "typescript"
  ],
  "homepage": "https://github.com/DynamicsNinja/garminconnect-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DynamicsNinja/garminconnect-js.git"
  },
  "bugs": {
    "url": "https://github.com/DynamicsNinja/garminconnect-js/issues"
  },
  "author": "ificko",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./exercises": {
      "import": {
        "types": "./dist/exercises.d.ts",
        "default": "./dist/exercises.js"
      },
      "require": {
        "types": "./dist/exercises.d.cts",
        "default": "./dist/exercises.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs/api",
    "README.md",
    "AGENTS.md",
    "WORKOUTS.md",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@types/node": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts examples",
    "format": "prettier --write .",
    "login": "tsx scripts/login.ts",
    "record": "tsx scripts/record-fixtures.ts",
    "demo": "tsx examples/demo.ts",
    "smoke": "tsx scripts/smoke-reads.ts",
    "smoke:write": "tsx scripts/smoke-writes.ts",
    "smoke:builder": "tsx scripts/smoke-builder.ts",
    "smoke:matrix": "tsx scripts/smoke-builder-matrix.ts",
    "verify:exercises": "tsx scripts/verify-exercises.ts",
    "login:real": "tsx scripts/login.ts ./tokens-real GARMIN_REAL",
    "smoke:real": "tsx scripts/smoke-readonly-real.ts",
    "smoke:gaps": "tsx scripts/smoke-writes-gaps.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "msw": "^2.6.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.0"
  },
  "typesVersions": {
    "*": {
      "exercises": [
        "./dist/exercises.d.ts"
      ]
    }
  }
}
