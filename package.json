{
  "name": "garminconnect-js",
  "version": "0.1.0",
  "description": "TypeScript client for the Garmin Connect API, for Node and Next.js server runtimes",
  "keywords": [
    "garmin",
    "garmin-connect",
    "garminconnect",
    "fitness",
    "health",
    "activities",
    "workouts",
    "nextjs",
    "typescript"
  ],
  "homepage": "https://github.com/DynamicsNinja/garminconnect-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DynamicsNinja/garminconnect-js.git"
  },
  "bugs": {
    "url": "https://github.com/DynamicsNinja/garminconnect-js/issues"
  },
  "author": "ificko",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "NOTICE"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@types/node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts examples",
    "format": "prettier --write .",
    "login": "tsx scripts/login.ts",
    "record": "tsx scripts/record-fixtures.ts",
    "demo": "tsx examples/demo.ts",
    "smoke": "tsx scripts/smoke-reads.ts",
    "smoke:write": "tsx scripts/smoke-writes.ts",
    "smoke:builder": "tsx scripts/smoke-builder.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "msw": "^2.6.0",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.0"
  }
}
